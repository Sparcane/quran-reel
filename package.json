{
  "name": "quran-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @quran/web",
    "dev": "npm run dev -w @quran/web",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:data": "node scripts/build-data.ts",
    "verify:data": "node scripts/verify-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
