{"number":68,"nameAr":"القلم","nameFr":"Al-Qalam","nameEn":"Al-Qalam","verseCount":52,"revelation":"meccan","verses":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","translations":{"fr":"","en":""}},{"number":2,"arabic":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","translations":{"fr":"","en":""}},{"number":3,"arabic":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","translations":{"fr":"","en":""}},{"number":4,"arabic":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","translations":{"fr":"","en":""}},{"number":5,"arabic":"فَسَتُبْصِرُ وَيُبْصِرُونَ","translations":{"fr":"","en":""}},{"number":6,"arabic":"بِأَييِّكُمُ ٱلْمَفْتُونُ","translations":{"fr":"","en":""}},{"number":7,"arabic":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","translations":{"fr":"","en":""}},{"number":8,"arabic":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","translations":{"fr":"","en":""}},{"number":9,"arabic":"وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ","translations":{"fr":"","en":""}},{"number":10,"arabic":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ","translations":{"fr":"","en":""}},{"number":11,"arabic":"هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ","translations":{"fr":"","en":""}},{"number":12,"arabic":"مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","translations":{"fr":"","en":""}},{"number":13,"arabic":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","translations":{"fr":"","en":""}},{"number":14,"arabic":"أَن كَانَ ذَا مَالٍ وَبَنِينَ","translations":{"fr":"","en":""}},{"number":15,"arabic":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","translations":{"fr":"","en":""}},{"number":16,"arabic":"سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ","translations":{"fr":"","en":""}},{"number":17,"arabic":"إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ","translations":{"fr":"","en":""}},{"number":18,"arabic":"وَلَا يَسْتَثْنُونَ","translations":{"fr":"","en":""}},{"number":19,"arabic":"فَطَافَ عَلَيْهَا طَآئِفٌ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ","translations":{"fr":"","en":""}},{"number":20,"arabic":"فَأَصْبَحَتْ كَٱلصَّرِيمِ","translations":{"fr":"","en":""}},{"number":21,"arabic":"فَتَنَادَوْا۟ مُصْبِحِينَ","translations":{"fr":"","en":""}},{"number":22,"arabic":"أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ","translations":{"fr":"","en":""}},{"number":23,"arabic":"فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ","translations":{"fr":"","en":""}},{"number":24,"arabic":"أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ","translations":{"fr":"","en":""}},{"number":25,"arabic":"وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَٰدِرِينَ","translations":{"fr":"","en":""}},{"number":26,"arabic":"فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ","translations":{"fr":"","en":""}},{"number":27,"arabic":"بَلْ نَحْنُ مَحْرُومُونَ","translations":{"fr":"","en":""}},{"number":28,"arabic":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ","translations":{"fr":"","en":""}},{"number":29,"arabic":"قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ","translations":{"fr":"","en":""}},{"number":30,"arabic":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَٰوَمُونَ","translations":{"fr":"","en":""}},{"number":31,"arabic":"قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ","translations":{"fr":"","en":""}},{"number":32,"arabic":"عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ","translations":{"fr":"","en":""}},{"number":33,"arabic":"كَذَٰلِكَ ٱلْعَذَابُ وَلَعَذَابُ ٱلْـَٔاخِرَةِ أَكْبَرُ لَوْ كَانُوا۟ يَعْلَمُونَ","translations":{"fr":"","en":""}},{"number":34,"arabic":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ","translations":{"fr":"","en":""}},{"number":35,"arabic":"أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ","translations":{"fr":"","en":""}},{"number":36,"arabic":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","translations":{"fr":"","en":""}},{"number":37,"arabic":"أَمْ لَكُمْ كِتَٰبٌ فِيهِ تَدْرُسُونَ","translations":{"fr":"","en":""}},{"number":38,"arabic":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","translations":{"fr":"","en":""}},{"number":39,"arabic":"أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ","translations":{"fr":"","en":""}},{"number":40,"arabic":"سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ","translations":{"fr":"","en":""}},{"number":41,"arabic":"أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ","translations":{"fr":"","en":""}},{"number":42,"arabic":"يَوْمَ يُكْشَفُ عَن سَاقٍ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ","translations":{"fr":"","en":""}},{"number":43,"arabic":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ","translations":{"fr":"","en":""}},{"number":44,"arabic":"فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ","translations":{"fr":"","en":""}},{"number":45,"arabic":"وَأُمْلِى لَهُمْ إِنَّ كَيْدِى مَتِينٌ","translations":{"fr":"","en":""}},{"number":46,"arabic":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","translations":{"fr":"","en":""}},{"number":47,"arabic":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","translations":{"fr":"","en":""}},{"number":48,"arabic":"فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ","translations":{"fr":"","en":""}},{"number":49,"arabic":"لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ","translations":{"fr":"","en":""}},{"number":50,"arabic":"فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ","translations":{"fr":"","en":""}},{"number":51,"arabic":"وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ","translations":{"fr":"","en":""}},{"number":52,"arabic":"وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ","translations":{"fr":"","en":""}}]}