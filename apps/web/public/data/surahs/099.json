{"number":99,"nameAr":"الزلزلة","nameFr":"Az-Zalzala","nameEn":"Az-Zalzala","verseCount":8,"revelation":"medinan","verses":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","translations":{"fr":"","en":""}},{"number":2,"arabic":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","translations":{"fr":"","en":""}},{"number":3,"arabic":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","translations":{"fr":"","en":""}},{"number":4,"arabic":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","translations":{"fr":"","en":""}},{"number":5,"arabic":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","translations":{"fr":"","en":""}},{"number":6,"arabic":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","translations":{"fr":"","en":""}},{"number":7,"arabic":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ","translations":{"fr":"","en":""}},{"number":8,"arabic":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","translations":{"fr":"","en":""}}]}